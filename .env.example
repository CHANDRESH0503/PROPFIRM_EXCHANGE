# Template only. Copy to .env.local and fill in there. NEVER put real values in this file:
# it is committed. .env.local is git-ignored (docs/runbooks/secrets.md).

# Environment name: local | staging | production
APP_ENV=local

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
SUPABASE_PROJECT_REF=
# Direct Postgres for migrations and backups (Connect → Session pooler; URL-encode the password)
SUPABASE_DB_URL=

# Encryption for voucher codes (32-byte base64; generate with: openssl rand -base64 32)
VOUCHER_ENCRYPTION_KEY=
IP_HASH_SALT=                       # openssl rand -hex 32

# Auth: Google sign-in (configured in the Supabase dashboard; kept here for reference)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bot protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Error tracking (Sentry, free plan). Leave empty to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local

# Telegram bot (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_CHAT_ID=              # admin alerts

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Economic calendar provider (licensed; must allow display and alerts)
CALENDAR_PROVIDER=fixture
CALENDAR_API_KEY=

# FX price data
FX_PRICE_PROVIDER=
FX_PRICE_API_KEY=

# MT5 sync (Phase 3)
MT5_INGEST_SECRET=

# Card payments for Pro (Phase 3, merchant of record)
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# Cron endpoints
CRON_SECRET=

# Web push (Phase 2)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Deploy (local machine only)
VPS_SSH=                             # user@host, key-based SSH
DEPLOY_DOMAIN=
